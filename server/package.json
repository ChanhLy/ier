    "@types/koa-logger": "^3.1.1",
    "@types/koa-session": "^5.10.2",
    "@types/koa__router": "^8.0.2",
    "@types/mocha": "^8.0.0",
    "@types/mongoose": "^5.7.32",
    "@types/node": "^14.0.24",
    "@types/validator": "^13.1.0",
    "@typescript-eslint/eslint-plugin": "^3.7.0",
    "@typescript-eslint/parser": "^3.7.0",
    "axios": "^0.19.2",
    "eslint": "^7.5.0",
